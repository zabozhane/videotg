BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHANNEL_ID=@your_channel_or_numeric_id

# Optional overrides
MAX_VIDEO_SIZE_MB=50
TEMP_DIR=temp
LOG_DIR=logs
LOG_LEVEL=INFO
DOWNLOAD_RETRIES=3
DOWNLOAD_TIMEOUT_SECONDS=600
UPLOAD_RETRIES=3
MAX_CONCURRENT_DOWNLOADS=3
HEALTH_HOST=0.0.0.0
HEALTH_PORT=8080

# H.264 + faststart для нормального воспроизведения в клиенте Telegram (true/false)
TELEGRAM_REENCODE_MP4=true
# Таймаут одной попытки sendVideo к API Telegram (сек); на медленном uplink VPS увеличьте
# TELEGRAM_SEND_VIDEO_TIMEOUT_SECONDS=3600
# Таймаут aiohttp-сессии бота (сек); мало → ошибки getUpdates при нагрузке ffmpeg
# TELEGRAM_API_SESSION_TIMEOUT_SECONDS=180

# Локально (macOS): Instagram через cookies из Chrome — залогиньтесь в instagram.com в Chrome
YTDLP_COOKIES_FROM_BROWSER=chrome

# На VPS без браузера: Netscape cookies.txt (см. README)
# YTDLP_COOKIEFILE=/path/to/instagram_cookies.txt

# Docker: снаружи контейнера (внутри health всегда на 8080, см. docker-compose)
# PUBLIC_HEALTH_PORT=8080

# В Docker на VPS: либо cookies.txt (volume в compose), либо профиль Firefox из сервиса ig-login (см. README)
# YTDLP_COOKIEFILE=/run/instagram_cookies.txt
# После логина в Instagram в Firefox на VPS (см. README):
# YTDLP_COOKIES_FROM_BROWSER=firefox:/igfirefox/.config/mozilla/firefox/xxxxxxxx.default-release

# Порт веб-интерфейса Firefox на localhost VPS (SSH-туннель с вашего ПК)
# IG_LOGIN_BROWSER_PORT=3100
# TZ=Europe/Moscow

# --- Deploy / автоматизация (бот их НЕ читает; только для ваших скриптов / CI)
# Не коммитьте .env с секретами. Пароль в файле — слабая практика; лучше SSH-ключ.
# VPS_HOST=203.0.113.10
# VPS_USER=deploy
# VPS_PORT=22
# Путь к приватному ключу на машине, откуда запускаете деплой:
# VPS_SSH_KEY_PATH=/home/you/.ssh/id_ed25519
# Только если без ключа (не рекомендуется):
 VPS_SSH_PASSWORD=your_password_here
# После логина в ig-firefox на VPS (см. README): bash deploy/apply_vps_instagram_firefox_env.sh
# (путь к профилю подставится сам, часто .config/mozilla/firefox/… у linuxserver/firefox)
